# http://editorconfig.org
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
insert_final_newline = false
trim_trailing_whitespace = true
end_of_line = lf

[*.xml]
indent_size = 4

[*.{yml,yaml}]
indent_size = 2
insert_final_newline = true
spaces_around_brackets = none

[*.java]
indent_size = 4
max_line_length = 120